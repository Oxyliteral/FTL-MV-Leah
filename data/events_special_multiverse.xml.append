<event name="SYLVAN_ROYAL_LEAH_DIALOGUE_6">
	<img back="BACK_EVENT_LEAHEVERYWHERE" planet="NONE"/>
	<changeBackground>BACK_EVENT_LEAHEVERYWHERE</changeBackground>
	<backgroundObject name="UNLOCK_QUEST_LEAH_PARADOX_GLITCH">
		<layer z="999">front</layer>
		<spawnArea x="400" y="188" w="0" h="0" center="true"/>
		<anim>glitch_paradox_leah</anim>
		<active>true</active>
		<jumpClear>true</jumpClear>
	</backgroundObject>
	<playSound>glitch</playSound>
	<triggeredEvent event="SYLVAN_ROYAL_LEAH_CLEAR_GLITCH" time="1" clearOnJump="true"/>
	<jumpEvent name="SYLVAN_ROYAL_LEAH_CLEAR_GLITCH" loop="false" priority="0">SYLVAN_ROYAL_LEAH_CLEAR_GLITCH</jumpEvent>
</event>

<ship name="LEAH_BEAM_MASTER_OBELISK_PARADOX" auto_blueprint="LEAH_BEAM_MASTER_OBELISK_PARADOX">
	<destroyed load="SYLVAN_ROYAL_LEAH_AFTER_CLEAR"/>
	<deadCrew load="SYLVAN_ROYAL_LEAH_AFTER_CLEAR"/>
</ship>
<event name="SYLVAN_ROYAL_LEAH_CLEAR_GLITCH">
	<clearJumpEvent name="SYLVAN_ROYAL_LEAH_CLEAR_GLITCH"/>
	<clearTriggeredEvent name="SYLVAN_ROYAL_LEAH_CLEAR_GLITCH"/>
	<clearBackgroundObject name="UNLOCK_QUEST_LEAH_PARADOX_GLITCH"/>
	<text>"AAAHHHHH MY SHIP--" The comms go silent for a moment. "I mean, uh, beyatch, I know we've had our differences, what with you being a beyatch and all, but could ya help a rival out here? Some weirdo teleported onto my ship and turned my crew turned against me! The nerve! Not as annoying as you, though. So, um, I don't have a ship to go to. Err.. well, uh, alas, I seem to have no other choice but to go with you! Of course you'll make room for your rival, right?" Leah beams onto your ship. "Let's take out that beyatch!"</text>
	<unlockCustomShip silent="false">PLAYER_SHIP_NEWTONBEAMF</unlockCustomShip>
	<crewMember amount="1" class="unique_leah_mfk">Leah</crewMember>
	<ship load="LEAH_BEAM_MASTER_OBELISK_PARADOX" hostile="true"/>
	<resetFtl/>
	<choice hidden="true">
		<text>Continue...</text>
		<event load="COMBAT_CHECK"/>
	</choice>
</event>

<event name="SYLVAN_ROYAL_LEAH_AFTER_CLEAR">
	<recallBoarders ship="both"/>
	<backgroundObject name="UNLOCK_QUEST_LEAH_PARADOX_GLITCH">
		<layer z="999">front</layer>
		<spawnArea x="400" y="188" w="0" h="0" center="true"/>
		<anim>glitch_paradox_leah</anim>
		<active>true</active>
		<jumpClear>true</jumpClear>
	</backgroundObject>
	<playSound>glitch</playSound>
	<triggeredEvent event="SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH" time="1" clearOnJump="true"/>
	<jumpEvent name="SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH" loop="false" priority="0">SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH</jumpEvent>
</event>


<event name="SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH">
	<clearJumpEvent name="SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH"/>
	<clearTriggeredEvent name="SYLVAN_ROYAL_LEAH_AFTER_CLEAR_GLITCH"/>
	<changeBackground>BACK_EVENT_LEAHNOTHING</changeBackground>
	<clearBackgroundObject name="UNLOCK_QUEST_LEAH_PARADOX_GLITCH"/>
	<text>Leah's ship phases back into view, still destroyed, except this time it's Leah who hails you. The normal Leah, not whatever you just faced.</text>
	<choice hidden="true" req="unique_leah_mfk" lvl="1" max_group="4" blue="false">
		<text>Your Leah seems confused by all this, but shrugs and goes back to whatever they were doing.</text>
		<event>
		<loadEventList seeded="false" default="SYLVAN_ROYAL_WIN">
			<event name="SYLVAN_ROYAL_WIN_DEAD" req="chaos_mode"/>
			<event name="SYLVAN_ROYAL_WIN_DEAD" req="loc_sylvankilled"/>
		</loadEventList>
		</event>
	</choice>
	<choice hidden="true" req="unique_leah_mfk" lvl="0" max_group="4" blue="false">
		<text>Continue...</text>
		<event>
		<loadEventList seeded="false" default="SYLVAN_ROYAL_WIN">
			<event name="SYLVAN_ROYAL_WIN_DEAD" req="chaos_mode"/>
			<event name="SYLVAN_ROYAL_WIN_DEAD" req="loc_sylvankilled"/>
		</loadEventList>
		</event>
	</choice>
</event>



<event name="SYLVAN_PACKAGE_KYLE_OFFER">
	<text>"Aaaaah." Sylvan chuckles upon seeing the package. "Yesss, I can ussse thisss. Let'sss sssee, your ssship could ussse an artillery. Honessstly ssspeaking, it could ussse two. How'sss, sssay, 100 ssscrap for one, and 175 ssscrap for two? Package included, of courssse."</text>
	<choice>
	<text>Install two artilleries.</text>
	<event>
		<text>"Good choice, ssstranger. Feel free to browssse while I work on your ssship, it'll be inssstalled by the time you're ready to jump."</text>
		<item_modify>   
			<item type="scrap" min="-175" max="-175"/>
		</item_modify>
		<remove name="LEAH_KYLE_PACKAGE"/>
		<choice hidden="true">
		<text>Continue...</text>
		<event>
			<text>Sylvan finishes installing the Artillery onto your ship.</text>
			<system name="artillery"/>
			<choice hidden="true">
				<text>Continue...</text>
				<event>
					<text>After making some finishing touches to the first Artillery, Sylvan installs the second.</text>
					<system name="artillery"/>
					<choice hidden="true" req="SEC FINAL" lvl="1" max_group="1" blue="false">
					<text>See what he's offering.</text>
					<event>
						<loadEvent>SYLVAN_TRADES_LASTSTAND</loadEvent>
					</event>
					</choice>
					<choice hidden="true" req="SEC STANDARD_SPACE" lvl="1" max_group="1" blue="false">
					<text>See what he's offering.</text>
					<event>
						<loadEvent>SYLVAN_TRADES_DROPPOINT</loadEvent>
					</event>
					</choice>
					<choice hidden="true" req="pilot" lvl="1" max_group="1" blue="false">
					<text>See what he's offering.</text>
					<event>
						<loadEvent>SYLVAN_TRADES</loadEvent>
					</event>
					</choice>
				</event>
			</choice>
		</event>
		</choice>
	</event>
	</choice>
	<choice>
	<text>Install one artillery.</text>
	<event>
		<text>"Good choice, ssstranger. Feel free to browssse while I work on your ssship, it'll be inssstalled by the time you're ready to jump."</text>
		<item_modify>   
			<item type="scrap" min="-100" max="-100"/>
		</item_modify>
		<remove name="LEAH_KYLE_PACKAGE"/>
		<choice hidden="true">
		<text>Continue...</text>
		<event>
			<text>Sylvan finishes installing the Artillery onto your ship.</text>
			<system name="artillery"/>
			<choice hidden="true" req="SEC FINAL" lvl="1" max_group="1" blue="false">
			<text>See what he's offering.</text>
			<event>
				<loadEvent>SYLVAN_TRADES_LASTSTAND</loadEvent>
			</event>
			</choice>
			<choice hidden="true" req="SEC STANDARD_SPACE" lvl="1" max_group="1" blue="false">
			<text>See what he's offering.</text>
			<event>
				<loadEvent>SYLVAN_TRADES_DROPPOINT</loadEvent>
			</event>
			</choice>
			<choice hidden="true" req="pilot" lvl="1" max_group="1" blue="false">
			<text>See what he's offering.</text>
			<event>
				<loadEvent>SYLVAN_TRADES</loadEvent>
			</event>
			</choice>
		</event>
		</choice>
	</event>
	</choice>
	<choice hidden="true">
	<text>Refuse the offer.</text>
	<event>
		<loadEvent>SYLVAN_PACKAGE_KYLE_REJECT</loadEvent>
	</event>
	</choice>
</event>

<event name="SYLVAN_PACKAGE_KYLE_REJECT">
	<text>"Aaaaah. Maybe a different time then, ssstranger. I'm ccccertain thisss won't be the lassst we sssee each other."</text>
	<choice hidden="true">
	<text>Continue...</text>
	<event>
		<loadEvent>SYLVAN_STANDARD</loadEvent>
	</event>
	</choice>
</event>



<event name="SYLVAN_PACKAGE_LEAH_STORE">
	<store>STORE_SYLVAN_PACKAGE_LEAH</store>
</event>

<event name="SYLVAN_PACKAGE_LEAH_READY">
	<text>"Aaaaah. Ssstranger ssstranger, your package isss ready."</text>
	<unlockCustomShip silent="false">PLAYER_SHIP_NEWTONBEAMB</unlockCustomShip>
	<choice hidden="true">
	<text>"YES! FINALLY!", you hear Leah scream.</text>
	<event>
		<loadEvent>SYLVAN_PACKAGE_LEAH_STORE</loadEvent>
	</event>
	</choice>
</event>

<event name="SYLVAN_PACKAGE_LEAH_NOTREADY">
	<text>"Ssstranger, your package isssn't ready yet. Ssshop at a different time, perhapsss..." Upon hearing this, Leah humphs in response.</text>
	<choice hidden="true">
	<text>Continue...</text>
	<event>
	<loadEvent>SYLVAN_STANDARD</loadEvent>
	</event>
	</choice>
</event>


<mod:findName type = "event" name = "SYLVAN_GIFT_LASTSTAND">
<mod-append:choice req="LIST_CREW_LEAH" max_group="666" hidden="true" blue="true">
<text>(Leah) Use Leah to hail Sylvan.</text>
<event>
	<loadEvent>SYLVAN_PACKAGE_LEAH_READY</loadEvent>
</event>
</mod-append:choice>
<mod-append:choice req="LEAH_KYLE_PACKAGE" max_group="667" hidden="true" blue="true">
<text>(Kyle's Package) Show Sylvan the package.</text>
<event>
	<loadEvent>SYLVAN_PACKAGE_KYLE_OFFER</loadEvent>
</event>
</mod-append:choice>
<mod:findWithChildLike type="choice" child-type="text">
<mod:selector>Decline his offer.</mod:selector>
<mod:setAttributes req="pilot" lvl="1" max_group="670" blue="false"/>
</mod:findWithChildLike>
</mod:findName>



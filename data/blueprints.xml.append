<shipBlueprint name="PLAYER_SHIP_LEAH_ION" layout="leah_beam" img="leah_ion">
	<class>The Ion Master</class>
	<name>Original I.M.</name>
	<unlock id="text_PLAYER_SHIP_LEAH_ION_unlock"/>
	<desc>"Remember when you used the reactor powering the shield generator at Delta-Base 9T-83 like an EMP field to shut off my ship? Genius move by the way - not to say you're actually smart or anything, just lucky - well it got me thinking. All this electricity stuff... it seems pretty powerful. So, screw the Beams! I'm the ION MASTER now! Get ioned, beyatch!"</desc>
	<systemList>
		<drones power="2" max="6" room="2" start="true" img="room_drones" />
		<engines power="1" max="2" room="9" start="true" img="room_engines">
			<slot>
